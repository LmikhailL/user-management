{
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-build-and-pr.sh\" 2>&1 || true",
            "if": "Bash(git commit *)",
            "timeout": 300,
            "statusMessage": "Formatting, building, and opening a PR if clean..."
          }
        ]
      }
    ]
  }
}
